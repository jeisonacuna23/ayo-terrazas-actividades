<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/verde_claro"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/verde_oscuro"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDiaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mar 15"
            android:textColor="@color/verde_oscuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActividadResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Culto de Enseñanza"
            android:textColor="@color/negro_contraste"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDirectorResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Director: Nombre"
            android:textColor="@color/negro_contraste"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPredicadorResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Predicador: Nombre"
            android:textColor="@color/negro_contraste"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvUjierResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ujier: Nombre"
            android:textColor="@color/negro_contraste"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSonidistaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sonidista: Nombre"
            android:textColor="@color/negro_contraste"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNotaResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota: ..."
            android:textColor="@color/verde_oscuro"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
